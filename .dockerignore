# Dependencies — installed fresh inside the image (host copies contain macOS binaries)
node_modules

# Build output — regenerated by `npm run build` in stage 1
dist

# VCS / editor
.git
.gitignore
.DS_Store

# Docs and plans — not needed to build the app
*.md

# Personal documents (CV source) — must not enter the image
*.docx

# Local dev notes (gitignored on host)
local_setup

# K8s/ops manifests — not part of the app build
kube-setup.yaml

# Lint config — not needed for `vite build`
eslint.config.js

# Docker build files themselves
Dockerfile
.dockerignore
